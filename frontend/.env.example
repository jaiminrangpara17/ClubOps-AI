# ClubOps AI — frontend environment configuration
# Copy to `.env.local` and adjust. Never commit real URLs/credentials.

# Base URL of the ClubOps backend API (no trailing slash).
# All feature services call `${VITE_API_BASE_URL}/events/...` etc.
VITE_API_BASE_URL=/api

# "api"  → every service calls the real backend.
# "mock" → every service uses its isolated LOCAL_DEVELOPMENT adapter.
# There is no mixed mode: real and mock records are never combined.
VITE_API_MODE=mock
