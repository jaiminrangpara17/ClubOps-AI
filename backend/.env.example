# ─────────────────────────────────────────────────────────────────────────────
# ClubOps AI — Backend environment configuration
# Copy this file to .env and fill in every value before starting the server.
# NEVER commit .env — it is listed in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL (used by docker-compose and the application) ──────────────────
POSTGRES_DB=clubops_ai
POSTGRES_USER=clubops
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_PORT=5432

# ── SQLAlchemy connection string ──────────────────────────────────────────────
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<db>
# When running postgres via docker-compose on the same machine use localhost.
DATABASE_URL=postgresql+psycopg://clubops:change_me_strong_password@localhost:5432/clubops_ai

# ── JWT Authentication ────────────────────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-to-a-long-random-hex-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── CORS — comma-separated list of allowed frontend origins ──────────────────
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# ── AI Provider (OpenAI-compatible) ──────────────────────────────────────────
# Leave AI_API_KEY empty to run without AI features (all other routes still work).
AI_API_KEY=
AI_MODEL=gpt-4o-mini