# ClubOps AI service - copy to ai/.env and fill in. NEVER commit ai/.env.

# ---- Service ----
SERVICE_NAME=clubops-ai
APP_ENV=development
LOG_LEVEL=INFO

# ---- LLM ----
# Supported: openai | gemini | groq | openrouter | ollama
LLM_PROVIDER=gemini
LLM_API_KEY=your-api-key-here
LLM_MODEL=gemini-2.0-flash
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# Optional overrides
# LLM_BASE_URL=
# LLM_MAX_OUTPUT_TOKENS=1024